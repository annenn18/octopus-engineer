{
  "name": "Flashcard Anything",
  "short_name": "Flashcards",
  "description": "Make flashcards and multiple-choice quizzes from word lists, Word, Excel, PDF or text files – and study them anywhere.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#FEFAF3",
  "theme_color": "#416B57",
  "lang": "en",
  "dir": "ltr",
  "categories": ["education", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Study", "short_name": "Study", "url": "./?tab=study", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Add flashcards", "short_name": "Add cards", "url": "./?tab=add&kind=vocab", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Quiz from study notes", "short_name": "Study notes", "url": "./?tab=add&kind=notes", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My files", "short_name": "My files", "url": "./?tab=files", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
